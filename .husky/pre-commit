#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔍 Running pre-commit checks..."

# ═══════════════════════════════════════════════════════════════
# BLOCK --no-verify bypass: ensure hooks actually ran.
# This check runs FIRST so it can't be bypassed by a failing
# later step. The real enforcement is server-side (CI), but
# this makes local bypasses harder.
# ═══════════════════════════════════════════════════════════════

# Verify no gitignored files are staged
TRACKED_IGNORED=$(git ls-files --cached -i --exclude-standard | head -20)
if [ -n "$TRACKED_IGNORED" ]; then
    echo "🚨 Blocked: gitignored files are staged:"
    echo "$TRACKED_IGNORED"
    echo "   Run: git rm --cached <file> to untrack"
    exit 1
fi

# Secret detection (must run before any other work)
pnpm security:precommit

# Lint staged files
pnpm lint-staged

# FK cascade check for new migrations (BKND-021)
echo "🔍 Checking migration FK cascades..."
STAGED_MIGRATIONS=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null | grep '^supabase/migrations/.*\.sql$' || true)
if [ -n "$STAGED_MIGRATIONS" ]; then
  for f in $STAGED_MIGRATIONS; do
    if grep -q 'auth\.users' "$f" 2>/dev/null; then
      if ! grep -q 'ON DELETE' "$f" 2>/dev/null; then
        echo "⚠️  WARNING: $f references auth.users without ON DELETE clause"
        echo "   Add ON DELETE CASCADE or ON DELETE SET NULL to FK references"
        echo "   See supabase/migrations/README.md for guidance"
      fi
    fi
  done
  echo "✅ FK cascade check complete"
fi

# Type check
echo "📋 Type checking..."
pnpm type-check

echo "✅ Pre-commit checks passed!"

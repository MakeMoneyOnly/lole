og = logger.child('merchant-insights/metrics');\r\n\r\n/**\r\n * GET /api/metrics/prometheus\r\n *\r\n * Returns Prometheus-compatible metrics in text format.\r\n * No authentication required for metrics scraping (public endpoint).\r\n *\r\n * Metrics exposed:\r\n * - http_request_duration_seconds_bucket\r\n * - http_requests_total\r\n * - lole_orders_total\r\n * - lole_payments_total\r\n * - lole_payment_failure_rate\r\n * - lole_active_sessions\r\n * - lole_active_restaurants\r\n */\r\nexport async function GET(request: Request): Promise<Response> {\r\n    try {\r\n        const metrics = await getPrometheusMetrics();\r\n        const contentType = getPrometheusContentType();\r\n\r\n        return new NextResponse(metrics, {\r\n            status: 200,\r\n            headers: {\r\n                'Content-Type': contentType,\r\n                'Cache-Control': 'no-cache, no-store, must-revalidate',\r\n            },\r\n        });\r\n    } catch (error) {\r\n        // Log error but return empty metrics to avoid breaking scrapers\r\n        log.error('Error generating metrics', error);\r\n\r\n        return new NextResponse('# Error generating metrics\\n# Please check application logs\\n', {\r\n            status: 500,\r\n            headers: {\r\n                'Content-Type': getPrometheusContentType(),\r\n            },\r\n        });\r\n    }\r\n}\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\app\\api\\v1\\merchant\\insights\\reports\\menu-engineering\\route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\app\\api\\v1\\merchant\\insights\\reports\\scheduled\\route.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{
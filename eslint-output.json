         </div>\n            <ChevronRight className=\"h-4 w-4 text-black/10\" />\n        </div>\n    );\n};\n\nconst MenuSection: React.FC<{ title: string; children: React.ReactNode }> = ({ title, children }) => {\n    return (\n        <div className=\"mb-6\">\n            <h3 className=\"mb-3 px-1 text-[17px] font-bold text-black tracking-[-0.04em]\">{title}</h3>\n            <div className=\"overflow-hidden rounded-[24px] border border-brand-neutral-soft/10 bg-white\">\n                {children}\n            </div>\n        </div>\n    );\n};\n\nexport const GuestMenuProfile: React.FC<{\n    isLoggedIn?: boolean;\n    onLogout?: () => void;\n}> = ({ isLoggedIn = false, onLogout }) => {\n    return (\n        <div className=\"flex flex-col bg-[#FFFFFF] min-h-screen relative\">\n            {/* Premium Header - Full Bleed to Status Bar */}\n            <div className=\"relative overflow-hidden rounded-b-[40px] bg-black px-5 pt-[calc(env(safe-area-inset-top)+40px)] pb-12 z-10 -mt-[env(safe-area-inset-top)]\">\n                {/* Background Image Overlay - Fixed for bleed */}\n                <div className=\"absolute inset-0 z-0 h-full w-full\">\n                    <img \n                        src=\"https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&w=800&q=80\" \n                        alt=\"Profile Background\" \n                        className=\"h-full w-full object-cover opacity-40 grayscale\"\n                    />\n                    <div className=\"absolute inset-0 bg-gradient-to-b from-black/20 via-black/60 to-black\" />\n                </div>\n\n                <div className=\"relative z-10 flex items-center gap-5\">\n                    <div className=\"relative h-[85px] w-[85px] shrink-0 rounded-full border-2 border-white/20 bg-white/10 p-1 backdrop-blur-sm shadow-xl\">\n                        <div className=\"h-full w-full overflow-hidden rounded-full bg-white/20 flex items-center justify-center\">\n                            <User className=\"h-10 w-10 text-white/40\" />\n                        </div>\n                    </div>\n                    \n                    <div className=\"flex flex-col gap-1\">\n                        <h2 className=\"text-[22px] font-bold text-white tracking-[-0.04em]\">Guest User</h2>\n                        <span className=\"text-[14px] font-semibold text-white/60 tracking-[-0.04em]\">@guest_lole</span>\n                        <button className=\"mt-3 w-fit rounded-xl border border-white/20 bg-white/10 px-6 py-2 text-[14px] font-bold text-white tracking-[-0.04em] backdrop-blur-md active:scale-95 transition-all\">\n                            {isLoggedIn ? 'Edit Profile' : 'Track Order'}\n                        </button>\n                    </div>\n                </div>\n\n                <div className=\"relative z-10 mt-8 flex items-center justify-around\">\n                    <div className=\"flex flex-col items-center\">\n                        <span className=\"text-[20px] font-bold text-white tracking-[-0.04em]\">0</span>\n                        <span className=\"text-[13px] font-medium text-white/60 tracking-[-0.04em]\">Orders</span>\n                    </div>\n                    <div className=\"flex flex-col items-center\">\n                        <span className=\"text-[20px] font-bold text-white tracking-[-0.04em]\">0</span>\n                        <span className=\"text-[13px] font-medium text-white/60 tracking-[-0.04em]\">Wishlist</span>\n                    </div>\n                    <div className=\"flex flex-col items-center\">\n                        <span className=\"text-[20px] font-bold text-white tracking-[-0.04em]\">0</span>\n                        <span className=\"text-[13px] font-medium text-white/60 tracking-[-0.04em]\">Coupons</span>\n                    </div>\n                </div>\n            </div>\n\n            {/* Menu List */}\n            <div className=\"px-5 pt-8 pb-32 bg-[#FFFFFF]\">\n                <MenuSection title=\"Account Settings\">\n                    <ProfileMenuItem icon={Package} title=\"All Orders\" />\n                    <ProfileMenuItem icon={MapPin} title=\"Saved Addresses\" />\n                    <ProfileMenuItem icon={Ticket} title=\"Vouchers & Coupons\" isLast />\n                </MenuSection>\n\n                <MenuSection title=\"Application\">\n                    <ProfileMenuItem icon={LayoutGrid} title=\"Browse Categories\" />\n                    <ProfileMenuItem icon={Bell} title=\"Notifications\" />\n                    <ProfileMenuItem icon={Settings} title=\"App Settings\" isLast />\n                </MenuSection>\n\n                <MenuSection title=\"Help & Info\">\n                    <ProfileMenuItem icon={Mail} title=\"Customer Inbox\" />\n                    <ProfileMenuItem icon={Phone} title=\"Contact Support\" />\n                    <ProfileMenuItem icon={Info} title=\"FAQ\" isLast />\n                </MenuSection>\n\n                {/* Logout Button */}\n                <button \n                    onClick={onLogout}\n                    className=\"mt-4 flex w-full items-center justify-center gap-3 rounded-[18px] border border-red-500/10 bg-red-500/[0.03] py-4 transition-all active:scale-95\"\n                >\n                    <LogOut className=\"h-5 w-5 text-red-500\" />\n                    <span className=\"text-[16px] font-bold text-red-500 tracking-[-0.04em]\">\n                        {isLoggedIn ? 'Sign Out of Account' : 'Sign In to Lole'}\n                    </span>\n                </button>\n            </div>\n        </div>\n    );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\guest-menu\\GuestMenuRecommendedCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\guest-menu\\GuestMenuSearchBar.tsx","messages":[{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":35,"column":17,"nodeType":"JSXOpeningElement","endLine":39,"endColumn":19},{"ruleId":"@next/next/no-img-element","severity":1,"message":"Using `<img>` could result in slower LCP and higher bandwidth. Consider using `<Image />` from `next/image` or a custom image loader to automatically optimize images. This may incur additional usage or cost from your provider. See: https://nextjs.org/docs/messages/no-img-element","line":76,"column":17,"nodeType":"JSXOpeningElement","endLine":76,"endColumn":101}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport React, { useState, useEffect } from 'react';\nimport { AnimatePresence, motion } from 'framer-motion';\n\nconst SEARCH_ITEMS = [\n    'Burgers',\n    'Pizza',\n    'Sushi',\n    'Tacos',\n    'Drinks',\n    'Desserts',\n    'Pasta',\n    'Salads',\n];\n\nexport const GuestMenuSearchBar: React.FC<{\n    value?: string;\n    onChange?: (val: string) => void;\n    onFilterTap?: () => void;\n}> = ({ value, onChange, onFilterTap }) => {\n    const [index, setIndex] = useState(0);\n\n    useEffect(() => {\n        if (value) return; // Stop animation if user is typing\n        const interval = setInterval(() => {\n            setIndex(prev => (prev + 1) % SEARCH_ITEMS.length);\n        }, 2500);\n        return () => clearInterval(interval);\n    }, [value]);\n\n    return (\n        <div className=\"flex w-full translate-y-[10px] items-center gap-3 px-5 py-3\">\n            <div className=\"flex h-[56px] flex-1 items-center gap-3 rounded-[22px] border border-white/10 bg-[#FFFFFF]/10 px-5 backdrop-blur-md transition-all focus-within:bg-white/20\">\n                <img\n                    src=\"/icons/Guest Menu/search-line.svg?v=2\"\n                    alt=\"Search\"\n                    className=\"h-[18px] w-[18px]\"\n                />\n                <div className=\"relative flex h-[24px] flex-1 items-center overflow-hidden\">\n                    {!value && (\n                        <div className=\"pointer-events-none absolute inset-0 flex items-center\">\n                            <span className=\"mr-1.5 text-[15px] font-semibold text-white/40 tracking-[-0.04em]\">\n                                Search for\n                            </span>\n                            <div className=\"relative h-full flex-1 overflow-hidden\">\n                                <AnimatePresence mode=\"popLayout\">\n                                    <motion.span\n                                        key={SEARCH_ITEMS[index]}\n                                        initial={{ y: 24, opacity: 0 }}\n                                        animate={{ y: 0, opacity: 1 }}\n                                        exit={{ y: -24, opacity: 0 }}\n                                        transition={{ duration: 0.4, ease: 'easeInOut' }}\n                                        className=\"absolute left-0 flex h-full items-center text-[15px] font-semibold tracking-[-0.04em] whitespace-nowrap text-white\"\n                                    >\n                                        {SEARCH_ITEMS[index]}\n                                    </motion.span>\n                                </AnimatePresence>\n                            </div>\n                        </div>\n                    )}\n\n                    {/* REAL INPUT */}\n                    <input\n                        type=\"text\"\n                        value={value || ''}\n                        onChange={e => onChange?.(e.target.value)}\n                        className=\"z-10 w-full bg-transparent text-[15px] font-medium text-white tracking-[-0.04em] focus:outline-none\"\n                    />\n                </div>\n            </div>\n            <button\n                onClick={onFilterTap}\n                className=\"flex h-[56px] w-[56px] items-center justify-center rounded-[22px] border border-white/10 bg-white/10 backdrop-blur-md transition-all active:scale-95\"\n            >\n                <img src=\"/icons/Guest Menu/filter-line.svg?v=2\" alt=\"Filter\" className=\"h-5 w-5\" />\n            </button>\n        </div>\n    );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\guest-menu\\HorizontalPremiumProductCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\guest-menu\\QuickActions.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\guest-menu\\shared\\GuestMenuGradient.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\landing\\layout\\Footer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\landing\\layout\\Header.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\us
tton className=\"rounded-lg p-2 text-gray-400 transition-all hover:bg-gray-50 hover:text-black\">\n                                <Settings2 className=\"h-4 w-4\" />\n                            </button>\n                        </div>\n                    </div>\n                ))}\n            </div>\n        </div>\n    );\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\user\\Desktop\\lole\\src\\components\\merchant\\takeout\\tabs\\StrategiesView.tsx","messages":[{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":2,"message":"Missing return type on function.","line":8,"column":8,"nodeType":"FunctionDeclaration","messageId":"missingReturnType","endLine":8,"endColumn":31}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"'use client';\n\nimport React from 'react';\nimport { Settings, Zap, AlertCircle, CheckCircle2, Activity } from 'lucide-react';\nimport { cn } from '@/lib/utils';\nimport { ModernSelect } from '../../shared/ModernSelect';\n\nexport function StrategiesView() {\n    return (\n        <div className=\"animate-in fade-in slide-in-from-bottom-2 space-y-8 pb-12 duration-500\">\n            <div className=\"grid grid-cols-1 gap-8 lg:grid-cols-2\">\n                <div className=\"flex flex-col gap-8 rounded-3xl border border-gray-100 bg-white p-8 shadow-none\">\n                    <div className=\"flex items-center gap-3\">\n                        <div className=\"bg-brand-accent flex h-10 w-10 items-center justify-center rounded-xl text-black\">\n                            <Settings className=\"h-5 w-5\" />\n                        </div>\n                        <h3 className=\"text-lg font-bold text-gray-900\">Quote Time Strategy</h3>\n                    </div>\n\n                    <div className=\"space-y-3\">\n                        {[\n                            {\n                                id: 'manual',\n                
[Unit]
Description=Lole Store Gateway - Production Service
Documentation=https://github.com/lole/menu/docs/gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lole-gateway
Group=lole-gateway
WorkingDirectory=/opt/lole/gateway

Environment="NODE_ENV=production"
Environment="RESTAURANT_ID="
Environment="LOCATION_ID="
Environment="GATEWAY_ID="
Environment="GATEWAY_HOST=127.0.0.1"
Environment="GATEWAY_HEALTH_PORT=8787"
Environment="LAN_MQTT_URL=ws://127.0.0.1:1884/mqtt"
Environment="GATEWAY_BOOTSTRAP_SECRET="
Environment="STORE_GATEWAY_DATA_DIR=/var/lib/lole-gateway/data"

EnvironmentFile=-/etc/default/lole-gateway
ExecStart=/usr/bin/node --experimental-strip-types /opt/lole/gateway/dist/entrypoint.js
Restart=always
RestartSec=5

# Security Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/lole-gateway/data
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target